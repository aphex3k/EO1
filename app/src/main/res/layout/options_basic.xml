<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textView1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Basic configuration"
            android:layout_marginTop="20sp"
            android:textAppearance="@style/TextAppearance.AppCompat.Large" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Media backends"
            android:layout_marginTop="20sp"
            android:textAppearance="@style/TextAppearance.AppCompat.Large" />

        <LinearLayout
            android:id="@+id/backendListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnAddImmich"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+ Add Immich backend" />

        <Button
            android:id="@+id/btnAddLocal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="+ Add Local uploads" />

        <Button
            android:id="@+id/btnAddWeb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="+ Add Website" />

        <Button
            android:id="@+id/btnAddFlickr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="+ Add Flickr" />

        <!-- ...existing time zone, quiet hours, and interval fields... -->
        <RadioGroup
            android:id="@+id/optionsRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/textView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Time Zone"
                android:textSize="22sp" />
            <Spinner
                android:id="@+id/tzSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:spinnerMode="dialog" />
        </RadioGroup>

        <TextView
            android:id="@+id/textView3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quiet hours (cron):"
            android:layout_marginTop="20sp"
            android:textAppearance="@style/TextAppearance.AppCompat.Large" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="minute hour day month weekday — the screen is off whenever any entry matches the time. Example: * 22-23,0-6 * * *" />
        <LinearLayout
            android:id="@+id/quietCronContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
        <Button
            android:id="@+id/btnAddQuietWindow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+ Add quiet window" />
        <TextView
            android:id="@+id/textView4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Slideshow interval (in minutes):"
            android:layout_marginTop="20sp"
            android:textAppearance="@style/TextAppearance.AppCompat.Large" />
        <EditText
            android:id="@+id/editTextInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="5" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Self-update"
            android:layout_marginTop="20sp"
            android:textAppearance="@style/TextAppearance.AppCompat.Large" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manifest URL (leave empty to disable self-update):" />
        <EditText
            android:id="@+id/editTextUpdateManifestUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:hint="http://your-host/eo1/update-manifest.json" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Check interval (in minutes):"
            android:layout_marginTop="8dp" />
        <EditText
            android:id="@+id/editTextUpdateCheckInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="120" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Trusted network"
            android:layout_marginTop="20sp"
            android:textAppearance="@style/TextAppearance.AppCompat.Large" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="When on, the LAN web UI allows full configuration, including credentials and backend edits, plus export/import of the configuration file." />
        <CheckBox
            android:id="@+id/trustedNetworkCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Trusted Network" />
        <TextView
            android:id="@+id/trustedNetworkTokenView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:visibility="gone" />
        <TextView
            android:id="@+id/trustedNetworkIpView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:visibility="gone" />
        <TextView
            android:id="@+id/loopbackAdbLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Without this, an update that passes every check stays staged until someone confirms it at the frame: a frame cannot install a package it does not have permission to install. With it, the frame starts the device's own adbd (a root shell on port 5555, reachable from anything that can route to it) only while it is installing a staged update, or while a recovery step it has actually reached needs the device's shell — and shuts it down again the moment that action ends. Idle time and boot need it open for nothing. Needs Trusted Network as well." />
        <CheckBox
            android:id="@+id/loopbackAdbCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Allow loopback ADB for update installs" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unattended recovery"
            android:layout_marginTop="20sp"
            android:textAppearance="@style/TextAppearance.AppCompat.Large" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The frame watches its own display loop and works down a ladder when nothing new appears while the screen should be on: re-drive the rotation, redraw the current asset, restart the app, nudge Wi-Fi through adbd. Rebooting the whole device is the last step and only happens if it is allowed here. Saved with the configuration, so the LAN web editor can change it too (trusted network required)." />
        <CheckBox
            android:id="@+id/autoRebootCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Reboot the frame if nothing else recovers it" />
    </LinearLayout>
</ScrollView>

