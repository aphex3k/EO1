<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"

    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        android:visibility="visible"
        android:src="@mipmap/wallpaper"
        tools:ignore="Deprecated" />

    <com.dd.crop.TextureVideoView
        android:background="@color/black"
        android:id="@+id/videoView"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:visibility="invisible"
        tools:ignore="Deprecated" />

    <EditText
        android:id="@+id/debugOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:accessibilityLiveRegion="none"
        android:clickable="false"
        android:cursorVisible="false"
        android:editable="false"
        android:ems="10"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:gravity="bottom|start"
        android:hint="@string/debug_information_will_show_here"
        android:importantForAutofill="no"
        android:inputType="text|textMultiLine|textNoSuggestions"
        android:lineSpacingExtra="8sp"
        android:scrollbars="none"
        android:selectAllOnFocus="false"
        android:singleLine="false"
        android:textColor="@color/purple_700"
        android:textIsSelectable="false"
        android:textSize="24sp"
        tools:ignore="Deprecated" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressIndicator"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_alignBottom="@id/imageView"
        android:background="#00000000"
        android:clickable="false"
        android:visibility="visible"
        app:indicatorColor="#A8FFFFFF"
        app:trackColor="#40FFFFFF"
        app:trackThickness="12dp"
        tools:ignore="Deprecated" />

    <!-- Sonos Banner View -->
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:padding="16dp"
        android:elevation="8dp"
        >

    <RelativeLayout
        android:id="@+id/sonosBannerView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/sonos_banner_bg"
        android:padding="16dp"
        android:alpha="0.0"
        tools:alpha="1.0"
        >

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:id="@+id/linearlayout1"
        >
            <TextView
                android:id="@+id/songTitleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="34sp"
                android:textStyle="bold"
                tools:text="A Nice Tree" />
            <View
                android:layout_width="50dp"
                android:layout_height="1dp"/>
            <TextView
                android:id="@+id/deviceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                tools:text="Kitchen +1"
            />
        </LinearLayout>
        <TextView
            android:id="@+id/songArtistLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/linearlayout1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            tools:text="Rob Boss" />
        </RelativeLayout>
    </RelativeLayout>

</RelativeLayout>