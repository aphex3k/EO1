<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"

    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <com.aphex3k.eo1.TsVideoView
        android:id="@+id/tsVideoView"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:visibility="invisible"
        tools:ignore="Deprecated" />

    <com.dd.crop.TextureVideoView
        android:id="@+id/videoView"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:visibility="invisible"
        tools:ignore="Deprecated" />

    <!-- ImageView above video surfaces so wallpaper covers TsPlayer until prepared.
         SurfaceView must be VISIBLE (under this) to create its surface. -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        android:visibility="visible"
        android:src="@mipmap/wallpaper"
        tools:ignore="Deprecated" />

    <EditText
        android:id="@+id/debugOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:accessibilityLiveRegion="none"
        android:clickable="false"
        android:cursorVisible="false"
        android:editable="false"
        android:ems="10"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:gravity="bottom|start"
        android:hint="@string/debug_information_will_show_here"
        android:importantForAutofill="no"
        android:inputType="text|textMultiLine|textNoSuggestions"
        android:lineSpacingExtra="8sp"
        android:scrollbars="none"
        android:selectAllOnFocus="false"
        android:singleLine="false"
        android:textColor="@color/purple_700"
        android:textIsSelectable="false"
        android:textSize="24sp"
        tools:ignore="Deprecated" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressIndicator"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_alignBottom="@id/imageView"
        android:background="#00000000"
        android:clickable="false"
        android:visibility="visible"
        app:indicatorColor="#A8FFFFFF"
        app:trackColor="#40FFFFFF"
        app:trackThickness="12dp"
        tools:ignore="Deprecated" />

    <!-- Sonos Banner View: one box, three stacked rows, hidden by visibility alone.

         Every row is maxLines="1" so the card's height cannot change between tracks, and wrap_content
         under a wrap_content box so the panel edge is what bounds it — a title too long for the panel
         ellipsizes instead of deciding the box's width.

         Two shapes here used to make that impossible, and both are gone on purpose. The anonymous outer
         RelativeLayout contributed 32dp of width and nothing else (its elevation was a no-op below API
         21); its margin is the same 16dp of offset. And the three labels used to divide one horizontal
         row, where measureHorizontal caps the row at the available width and measures everything after
         the cap against what is left — so a long title stretched the box to nearly the panel width and
         collapsed the group label to zero width at the same time. The Java had been writing that label
         all along; there was simply no room for it.

         android:visibility rather than android:alpha="0.0" is the hide mechanism. With alpha the box was
         laid out, empty and transparent, at bottom-centre from the first inflate, and the fade's
         fillAfter transform stayed attached over whatever setAlpha the next show asked for. alpha is
         now only ever non-1 while a fade is actually running. -->
    <RelativeLayout
        android:id="@+id/sonosBannerView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_margin="16dp"
        android:background="@drawable/sonos_banner_bg"
        android:padding="16dp"
        android:visibility="gone"
        tools:visibility="visible"
        >

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
        >
            <TextView
                android:id="@+id/songTitleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="34sp"
                android:textStyle="bold"
                tools:text="A Nice Tree" />
            <TextView
                android:id="@+id/songArtistLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                tools:text="Rob Boss" />
            <TextView
                android:id="@+id/deviceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                tools:text="Kitchen + 3"
            />
        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>