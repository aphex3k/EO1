# The Gradle wrapper jar is a tiny (~44KB) build prerequisite that every
# CI/Actions checkout needs. It is committed as a regular git object, not
# LFS: this repo is a GitHub fork, and forks cannot serve their own LFS
# objects, so Actions checkouts 404 on the wrapper's LFS oid and ./gradlew
# cannot start. The blanket *.jar LFS rule above must not re-capture it.
gradle/wrapper/gradle-wrapper.jar -filter -diff -merge -text
# Unit-test signature fixtures (small signed .zip files) must also be regular git
# objects for the same fork/LFS reason: they are read on every test run.
app/src/test/resources/update-fixtures/** -filter -diff -merge -text
